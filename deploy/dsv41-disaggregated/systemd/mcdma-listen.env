# Parameters of the listen end of link @LINK_NAME@ (installed as mcdma-listen-@LINK_NAME@.env).
# VIA is the LAN interface and the Mac's LAN link-local address, never the cable's interface; the port follows the
# last colon. PEER_DEV is the RDMA device of the Mac-facing port, PEER_GID_INDEX its RoCE v2 link-local GID.
PEER_DEV=@PEER_DEV@
PEER_GID_INDEX=@PEER_GID_INDEX@
PATH_MTU=4096
VIA=@LAN_IF@/@MAC_LAN_LL@:@EXCHANGE_PORT@
# mailbox halves in MiB; both ends of the link must use the same two numbers
REQ_MIB=4
REP_MIB=64

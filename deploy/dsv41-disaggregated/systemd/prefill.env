# The tuned prefill profile for both ranks of the pair (identical on both machines; the rank and the NCCL pin are in the
# units). systemd reads plain NAME=value lines: no expansion, no quotes. Do not set TF_DSV41_PREFILL_PIECES,
# TF_DSV41_KV_SPLIT or TF_DSV41_HANDOFF_DUMP: an exporter refuses the first two and the dump blocks the engine thread.
TF_EXPERIMENTAL=deepseek
# the pair's TP link
TF_COMM_BACKEND=roce
TF_TP_WORLD=2
TF_TP_DEVICE=0
TF_TP_MASTER=@TP_MASTER_ADDR@
TF_TP_PORT=29571
TF_TP_KERNEL_IMAGE=@TF_PREFIX@/tp_mailbox.fatbin
TF_TP_PLAN_TIMEOUT=1800
TF_TP_MAILBOX_MAX_KB=1024
TF_TP_ROCE_FAST=1
TF_TP_PLAN_LINK=rdma
TF_TP_PLAN_PIN=auto
NCCL_CUMEM_ENABLE=0
NCCL_CUMEM_HOST_ENABLE=0
TF_NCCL_LIB=@NCCL_LIB_DIR@/libnccl.so.2
LD_LIBRARY_PATH=@TF_PREFIX@/lib:@NCCL_LIB_DIR@
# engine files
TF_DSV41_ASSETS=@TF_ASSETS@
TF_DSV41_ENGRAM_DIR=@TF_ENGRAM@
TF_DSV41_SESSION_DISK=@TF_STATE@/sessions
TF_DSV41_CONTEXT=131072
TF_DSV41_SLOTS=1
TF_DSV41_SESSIONS=1
TF_DSV41_SESSION_RAM_MIB=1024
TF_DSV41_SESSION_DISK_GIB=32
TF_DSV41_SESSION_DISK_MIN=1024
# the tuned export profile (docs/deepseek-v41-disaggregated.md, section 6)
TF_DSV41_POOL_TOKENS=65536
TF_DSV41_FORMS_INPLACE=1
TF_DSV41_SAMPLING=1
TF_DSV41_GM_V2=1
TF_DSV41_GM_V3=1
TF_DSV41_PF_DENSE=fused
TF_DSV41_PF_DENSE_TABLE=@TF_STATE@/pfdense-table.json
TF_DSV41_L2PF=1
TF_DSV41_L2PF_MB=12
TF_DSV41_L2PF_PACE_GBPS=150
TF_DSV41_PREFETCH_AHEAD=1
TF_DSV41_ENGRAM_AIO=1
TF_DSV41_BRANCHES=1
TF_DSV41_BRANCHES_PRIO=side
TF_DSV41_PF_OVERLAP=4

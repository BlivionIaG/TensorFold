+    head_drafts: bool,
+    proposal_depth: ?u32,
+    hold_context_rows: u32,
+    copy_width: ?u32,
+    draft_room: i64,
+    drafted: u64,
+    accepted: u64,
+    alone: bool,
+};
+const Allocation = struct {
+    first_decision: usize,
+    decisions: usize,
+    streams: usize,
+    max_rows: usize,
+    explicit: bool,
+    live: bool,
+    sampled: bool,
+    overhead: u64,
+    nearest_streams: ?u32,
+    fixed: ?u64,
+    head: ?u64,
+    timed: bool,
+    cost_slots: usize,
+    costs: [max_width + 1]?u64,
+    probe_rows: ?u32,
+};
+const Decision = struct {
+    plan: ?usize,
+    request: ?usize,
+    round: u64,
+    fixed: u32,
+    offered: usize,
+    allocated: u32,
+    chances_len: usize,
+    chances: [max_depth]u64,
+    row_quote: ?u64,
+    row_applied: ?u64,
+    grammar: bool,
+    finished: bool,
+    paused: bool,
+};
+const OverheadSample = struct {
+    after_allocation: ?usize,
+    streams: u32,
+    rows: u64,
+    sampled: bool,
+    net_ms: u64,
+    head_ms: u64,
+    forward_ms: ?u64,
+    extra_ms: ?u64,
+    fixed_ms: ?u64,
+};
+const Startup = struct {
+    shared_slots: usize,
+    family_slots: usize,
+    shared: [max_width + 1]?u64,
+    family: [max_width + 1]?u64,
+    hold_entries: usize,
+    context_entries: usize,
+    batch_rows: u32,
+    first_copy: u32,
+    max_copy: u32,
+    enter_match: i64,
+    copy_rate: u64,
+    own_copy_rates: bool,
+    matched_copy_rates: bool,
+    timed: bool,
+};
+var requests: [max_requests]Request = undefined;
+var planned: [max_plans]Planned = undefined;
+var allocations: [max_rounds]Allocation = undefined;
+var decisions: [max_plans]Decision = undefined;
+var overhead_samples: [max_rounds]OverheadSample = undefined;
+var startup: ?Startup = null;
+var startup_reported = false;
+var request_count: usize = 0;
+var planned_count: usize = 0;
+var allocation_count: usize = 0;
+var decision_count: usize = 0;
+var overhead_count: usize = 0;
+var dropped: [5]u64 = @splat(0);
+var copy_phase: u64 = 1;
+
+fn resetCopies() void {
+    startup = null;
+    startup_reported = false;
+    clearCopies();
+    copy_phase = 1;
+}
+
+fn clearCopies() void {
+    request_count = 0;
+    planned_count = 0;
+    allocation_count = 0;
+    decision_count = 0;
+    overhead_count = 0;
+    dropped = @splat(0);
+}
+
+fn bits(value: f64) u64 {
+    return @bitCast(value);
+}
+
+fn optionalBits(value: ?f64) ?u64 {
+    return if (value) |v| bits(v) else null;
+}
+
+fn prices(table: anytype) [max_width + 1]?u64 {
+    var out: [max_width + 1]?u64 = undefined;
+    for (&out, 0..) |*value, width| value.* = optionalBits(table.get(@intCast(width)));
+    return out;
+}
+
+fn request(s: anytype) ?usize {
+    const id_hash = std.hash.Wyhash.hash(0, s.id);
+    for (requests[0..request_count], 0..) |r, i| {
+        if (r.ptr == @intFromPtr(s) and r.id_hash == id_hash) return i;
+    }
+    if (request_count == requests.len) {
+        dropped[0] += 1;
+        return null;
+    }
+    const index = request_count;
+    request_count += 1;
+    const r = &requests[index];
+    r.* = .{
+        .ptr = @intFromPtr(s),
+        .id_hash = id_hash,
+        .id = undefined,
+        .id_len = s.id.len,
+        .prompt_hash = std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(s.context.items[0..@min(s.prompt_len, s.context.items.len)])),
+        .prompt_len = s.prompt_len,
+        .max_new = s.max_new,
+    };
+    const n = @min(s.id.len, r.id.len);
+    @memcpy(r.id[0..n], s.id[0..n]);
+    return index;
+}
+
+pub fn plannedCopy(e: anytype, p: anytype) void {
+    if (!copy_trace_enabled) return;
+    if (startup == null) {
+        const c = e.cfg;
+        startup = .{
+            .shared_slots = c.shared_costs.slots.len, .family_slots = c.family_costs.slots.len,
+            .shared = prices(c.shared_costs), .family = prices(c.family_costs),
+            .hold_entries = c.k.hold_costs.len, .context_entries = c.k.hold_context_costs.len,
+            .batch_rows = c.batch_rows, .first_copy = c.first_copy, .max_copy = c.max_copy,
+            .enter_match = c.enter_match, .copy_rate = bits(c.copy_rate),
+            .own_copy_rates = c.own_copy_rates, .matched_copy_rates = c.matched_copy_rates, .timed = c.timed,
+        };
+    }
+    if (planned_count == planned.len) {
+        dropped[1] += 1;
+        return;
+    }
+    const s = p.stream;
+    const r = &planned[planned_count];
+    planned_count += 1;
+    r.* = .{
+        .request = request(s), .round = s.rounds, .position = p.position,
+        .context_len = s.context.items.len, .pending = s.pending, .kind = @tagName(p.kind),
+        .offered = p.count(), .held = p.held, .tokens = undefined,
+        .token_count = @min(p.tokens.len, max_depth), .suffix = undefined,
+        .suffix_count = @min(s.context.items.len, 8),
+        .last_match = if (s.proposer) |pr| pr.lastMatch() else null,
+        .last_end = if (s.proposer) |pr| pr.lastEnd() else null,
+        .trusted = p.copy_trusted, .recalled = p.recalled, .reserved = s.reserved_copy != null,
+        .head_context = s.head_context, .cohort = s.prefill_cohort, .head_drafts = s.headDrafts(),
+        .proposal_depth = s.proposal_depth, .hold_context_rows = s.hold_context_rows,
+        .copy_width = s.copy_width, .draft_room = s.draftRoom(), .drafted = s.drafted,
+        .accepted = s.accepted, .alone = e.alone,
+    };
+    @memcpy(r.tokens[0..r.token_count], p.tokens[0..r.token_count]);
+    @memcpy(r.suffix[0..r.suffix_count], s.context.items[s.context.items.len - r.suffix_count ..]);
+}
+
+pub fn allocatedCopies(e: anytype, plans: anytype, fixed: []const u32, probs: []const []const f64, costs: anytype, overhead: f64, row_ms: []const f64, counts_: []const u32, explicit: bool, live: bool, sampled: bool) void {
+    if (!copy_trace_enabled) return;
+    if (allocation_count == allocations.len) {
+        dropped[2] += 1;
+        return;
+    }
+    const nearest = e.rule.privateOverhead(plans.len, sampled);
+    const record = &allocations[allocation_count];
+    allocation_count += 1;
+    record.* = .{
+        .first_decision = decision_count, .decisions = 0, .streams = plans.len,
+        .max_rows = @max(plans.len, e.cfg.batch_rows), .explicit = explicit, .live = live,
+        .sampled = sampled, .overhead = bits(overhead),
+        .nearest_streams = if (nearest) |n| n.streams else null,
+        .fixed = if (nearest) |n| bits(n.ms) else null, .head = if (nearest) |n| bits(n.head) else null,
+        .timed = !costs.empty(), .cost_slots = costs.slots.len,
+        // Shared startup prices are immutable; don't recopy or redump them each round.
+        .costs = if (live and !explicit) prices(costs.*) else undefined,
+        .probe_rows = if (plans.len == 1) plans[0].cost_probe_rows else null,
+    };
+    for (plans, fixed, probs, counts_, 0..) |p, f_, chances, count_, i| {
+        if (decision_count == decisions.len) {
+            dropped[3] += 1;
+            continue;
+        }
+        const req = request(p.stream);
+        var plan_index: ?usize = null;
+        var j = planned_count;
+        while (j > planned_count -| plans.len) {
+            j -= 1;
+            if (req != null and planned[j].request == req and planned[j].round == p.stream.rounds) {
+                plan_index = j;
+                break;
+            }
+        }
+        const d = &decisions[decision_count];
+        decision_count += 1;
+        record.decisions += 1;
+        d.* = .{
+            .plan = plan_index, .request = req, .round = p.stream.rounds,
+            .fixed = f_, .offered = p.count(), .allocated = count_,
+            .chances_len = chances.len, .chances = undefined,
+            .row_quote = optionalBits(p.stream.verify_row_ms),
+            .row_applied = if (row_ms.len > 0) bits(row_ms[i]) else null,
+            .grammar = p.stream.grammar != null, .finished = p.stream.finished, .paused = p.stream.paused,
+        };
+        for (d.chances[0..@min(chances.len, max_depth)], chances[0..@min(chances.len, max_depth)]) |*out, value| out.* = bits(value);
+    }
+}
+
+// Called only after the existing clock observation. These are the exact inputs to
+// observeOverhead (already net of quoted host draws / modeled extra head steps).
+pub fn observedCopyOverhead(streams: u32, rows: u64, ms: f64, sampled: bool, head_ms: f64, forward: ?f64, extra: ?f64, fixed: ?f64) void {
+    if (!copy_trace_enabled) return;
+    if (overhead_count == overhead_samples.len) {
+        dropped[4] += 1;
+        return;
+    }
+    overhead_samples[overhead_count] = .{
+        .after_allocation = if (allocation_count > 0) allocation_count - 1 else null,
+        .streams = streams, .rows = rows, .sampled = sampled,
+        .net_ms = bits(ms), .head_ms = bits(head_ms), .forward_ms = optionalBits(forward),
+        .extra_ms = optionalBits(extra), .fixed_ms = optionalBits(fixed),
+    };
+    overhead_count += 1;
+}
+
+fn reportCopies() void {
+    if (!startup_reported) if (startup) |s| {
+        print("DSPARK_PRIVATE_COPY_STARTUP version=1 float_encoding=f64_bits_u64 max_width={d} shared_slots={d} family_slots={d} hold_entries={d} context_entries={d} batch_rows={d} first_copy={d} max_copy={d} enter_match={d} copy_rate_bits={d} own_copy_rates={} matched_copy_rates={} timed={}\n", .{ max_width, s.shared_slots, s.family_slots, s.hold_entries, s.context_entries, s.batch_rows, s.first_copy, s.max_copy, s.enter_match, s.copy_rate, s.own_copy_rates, s.matched_copy_rates, s.timed });
+        for (s.shared, s.family, 0..) |shared, family, width| {
+            print("DSPARK_PRIVATE_COPY_STARTUP_PRICE width={d} shared_ms_bits={any} family_ms_bits={any}\n", .{ width, shared, family });
+        }
+        startup_reported = true;
+    };
+    if (planned_count == 0 and allocation_count == 0 and overhead_count == 0) return;
+    print("DSPARK_PRIVATE_COPY_PHASE phase={d} snapshot={d} requests={d} plans={d} allocations={d} decisions={d} overheads={d} dropped_request_plan_allocation_decision_overhead={any} max_depth={d} max_width={d} storage_bytes={d}\n", .{ copy_phase, snapshot_count, request_count, planned_count, allocation_count, decision_count, overhead_count, dropped, max_depth, max_width, @sizeOf(@TypeOf(requests)) + @sizeOf(@TypeOf(planned)) + @sizeOf(@TypeOf(allocations)) + @sizeOf(@TypeOf(decisions)) + @sizeOf(@TypeOf(overhead_samples)) });
+    for (requests[0..request_count], 0..) |r, i| {
+        var id: [192]u8 = undefined;
+        const alphabet = "0123456789abcdef";
+        const n = @min(r.id_len, r.id.len);
+        for (r.id[0..n], 0..) |byte, j| {
+            id[j * 2] = alphabet[byte >> 4];
+            id[j * 2 + 1] = alphabet[byte & 15];
+        }
+        print("DSPARK_PRIVATE_COPY_REQUEST phase={d} request={d} id_hex={s} id_len={d} id_hash={x} prompt_hash={x} prompt_len={d} max_new={d}\n", .{ copy_phase, i, id[0 .. n * 2], r.id_len, r.id_hash, r.prompt_hash, r.prompt_len, r.max_new });
+    }
+    for (planned[0..planned_count], 0..) |p, i| {
+        print("DSPARK_PRIVATE_COPY_PLAN phase={d} plan={d} request={any} round={d} position={d} context_len={d} pending={any} kind={s} offered={d} held={d} tokens={any} suffix={any} last_match={any} last_end={any} trusted={} recalled={} reserved={} head_context={any} cohort={d} head_drafts={} proposal_depth={any} hold_context_rows={d} copy_width={any} draft_room={d} drafted={d} accepted={d} alone={}\n", .{ copy_phase, i, p.request, p.round, p.position, p.context_len, p.pending, p.kind, p.offered, p.held, p.tokens[0..p.token_count], p.suffix[0..p.suffix_count], p.last_match, p.last_end, p.trusted, p.recalled, p.reserved, p.head_context, p.cohort, p.head_drafts, p.proposal_depth, p.hold_context_rows, p.copy_width, p.draft_room, p.drafted, p.accepted, p.alone });
+    }
+    for (allocations[0..allocation_count], 0..) |a, i| {
+        print("DSPARK_PRIVATE_COPY_ALLOCATION phase={d} allocation={d} streams={d} max_rows={d} explicit={} live={} sampled={} overhead_ms_bits={d} nearest_streams={any} fixed_ms_bits={any} head_ms_bits={any} timed={} cost_source={s} cost_slots={d} probe_rows={any}\n", .{ copy_phase, i, a.streams, a.max_rows, a.explicit, a.live, a.sampled, a.overhead, a.nearest_streams, a.fixed, a.head, a.timed, if (a.explicit) "untimed" else if (a.live) "live" else "shared", a.cost_slots, a.probe_rows });
+        if (a.live and !a.explicit) {
+            // Small chunks stay below the single-write bound even at u64 max.
+            var width: usize = 0;
+            while (width < a.costs.len) : (width += 8) {
+                print("DSPARK_PRIVATE_COPY_PRICES phase={d} allocation={d} first_width={d} ms_bits={any}\n", .{ copy_phase, i, width, a.costs[width..@min(width + 8, a.costs.len)] });
+            }
+        }
+        for (decisions[a.first_decision .. a.first_decision + a.decisions], 0..) |d, order| {
+            print("DSPARK_PRIVATE_COPY_DECISION phase={d} allocation={d} order={d} plan={any} request={any} round={d} fixed={d} offered={d} allocated={d} chances_len={d} chances_bits={any} row_quote_ms_bits={any} row_applied_ms_bits={any} grammar={} finished={} paused={}\n", .{ copy_phase, i, order, d.plan, d.request, d.round, d.fixed, d.offered, d.allocated, d.chances_len, d.chances[0..@min(d.chances_len, max_depth)], d.row_quote, d.row_applied, d.grammar, d.finished, d.paused });
+        }
+    }
+    for (overhead_samples[0..overhead_count], 0..) |o, i| {
+        print("DSPARK_PRIVATE_COPY_OVERHEAD phase={d} observation={d} after_allocation={any} streams={d} rows={d} sampled={} net_ms_bits={d} head_ms_bits={d} forward_ms_bits={any} extra_ms_bits={any} fixed_ms_bits={any}\n", .{ copy_phase, i, o.after_allocation, o.streams, o.rows, o.sampled, o.net_ms, o.head_ms, o.forward_ms, o.extra_ms, o.fixed_ms });
+    }
+    clearCopies();
+    copy_phase += 1;
+}
diff --git a/zig/src/core/lfm2_target_counters_private.zig b/zig/src/core/lfm2_target_counters_private.zig
new file mode 100644
index 000000000..50948a6a9
--- /dev/null
+++ b/zig/src/core/lfm2_target_counters_private.zig
@@ -0,0 +1,116 @@
+//! Private same-command-buffer target attribution; never a performance qualification.
+const std = @import("std");
+const mtl = @import("metal");
+const gpu = @import("gpu_counters.zig");
+const diagnostic = @import("lanes").dspark_probe_private;
+pub const Class = gpu.Class;
+
+pub const Call = struct {
+    rows: usize,
+    segments: usize,
+    recorded: bool,
+    unrecorded_head_last: bool,
+    tiled: bool,
+    head_rows: usize,
+    captured: bool,
+};
+
+pub const Probe = struct {
+    recorder: gpu.Recorder,
+    active: bool = false,
+    span_open: bool = false,
+    encoding_closed: bool = true,
+    call: u64 = 0,
+    context: Call = undefined,
+
+    /// The frozen driver preserves this non-TF_ name. Unset/0 keeps the original encoder and no counter storage.
+    pub fn init(allocator: std.mem.Allocator, device: mtl.Device, max_spans: usize) !Probe {
+        const value = std.mem.span(std.c.getenv("LFM2_PRIVATE_TARGET_COUNTERS") orelse "0");
+        const requested = std.mem.eql(u8, value, "1");
+        if (!requested and !std.mem.eql(u8, value, "0")) {
+            diagnostic.print("LFM2_PRIVATE_TARGET_GPU_INIT invalid=true error=InvalidPrivateTargetCounters\n", .{});
+            return error.InvalidPrivateTargetCounters;
+        }
+        // One fresh native server per diagnostic arm: a prior Engine.init cannot identify a new model's calibration.
+        if (requested and diagnostic.engine_initialized) {
+            diagnostic.print("LFM2_PRIVATE_TARGET_GPU_INIT invalid=true error=TargetCountersRequireFreshProcess\n", .{});
+            return error.TargetCountersRequireFreshProcess;
+        }
+        const recorder = gpu.Recorder.init(allocator, device, .{ .enabled = requested, .max_spans = max_spans }) catch |err| {
+            diagnostic.print("LFM2_PRIVATE_TARGET_GPU_INIT mode={s} invalid=true error={s}\n", .{ @tagName(mtl.counters.query(device).mode()), @errorName(err) });
+            return err;
+        };
+        if (requested) diagnostic.print("LFM2_PRIVATE_TARGET_GPU_INIT enabled=true mode={s} max_spans={d} calibration=excluded activation=LFM2_PRIVATE_TARGET_COUNTERS\n", .{ @tagName(recorder.capability().mode()), max_spans });
+        return .{ .recorder = recorder };
+    }
+
+    pub fn begin(self: *Probe, cb: mtl.CommandBuffer, context: Call) !void {
+        self.encoding_closed = false;
+        self.span_open = false;
+        self.active = self.recorder.enabled() and diagnostic.engine_initialized;
+        if (!self.active) return;
+        self.context = context;
+        self.call += 1;
+        try self.recorder.beginCommand(cb);
+    }
+
+    /// Every boundary precedes complete pipeline/buffer rebinding by the caller.
+    pub fn next(self: *Probe, encoder: *mtl.ComputeEncoder, kind: Class) !void {
+        if (!self.active) return;
+        if (self.span_open) try self.recorder.endSpan(encoder);
+        self.span_open = false;
+        try self.recorder.beginSpan(encoder, kind);
+        self.span_open = true;
+    }
+
+    pub fn rotated(self: *const Probe) bool {
+        return self.active and self.recorder.capability().mode() == .stage;
+    }
+
+    pub fn finish(self: *Probe, encoder: *mtl.ComputeEncoder) !void {
+        if (self.active) {
+            if (self.span_open) try self.recorder.endSpan(encoder);
+            self.span_open = false;
+            try self.recorder.finishEncoding(encoder);
+        } else encoder.end();
+        self.encoding_closed = true;
+    }
+
+    /// Called only on an unsubmitted command, or after the forward's existing final wait.
+    pub fn abort(self: *Probe, encoder: *mtl.ComputeEncoder, completed: bool, err: anyerror) void {
+        if (self.active) {
+            const ctx = self.context;
+            diagnostic.print("LFM2_PRIVATE_TARGET_GPU call={d} rows={d} segments={d} recorded={} unrecorded_head_last={} phase=serving mode={s} invalid=true error={s}\n", .{ self.call, ctx.rows, ctx.segments, ctx.recorded, ctx.unrecorded_head_last, @tagName(self.recorder.capability().mode()), @errorName(err) });
+            if (completed) {
+                self.recorder.discardAfterCompletion() catch unreachable;
+            } else self.recorder.cancelEncoding(encoder) catch unreachable;
+        } else if (!self.encoding_closed) encoder.end();
+        self.active = false;
+        self.encoding_closed = true;
+        self.span_open = false;
+    }
+
+    /// Resolution/calibration happens after the caller's original wait. No per-span waits or GPU submits.
+    pub fn report(self: *Probe, command_seconds: f64) !void {
+        if (!self.active) return;
+        const spans = try self.recorder.readAfterCompletion();
+        const calibration = self.recorder.calibration orelse return error.MissingClockCalibration;
+        var total: f64 = 0;
+        var buffer: [2048]u8 = undefined;
+        var used: usize = 0;
+        for (std.enums.values(Class), self.recorder.aggregates()) |kind, aggregate| {
+            if (aggregate.calls == 0) continue;
+            total += aggregate.gpu_seconds;
+            const text = try std.fmt.bufPrint(buffer[used..], " {s}={d}:{d:.6}", .{ @tagName(kind), aggregate.calls, aggregate.gpu_seconds * 1e3 });
+            used += text.len;
+        }
+        if (total <= 0 or !std.math.isFinite(total)) return error.InvalidCounterSample;
+        const ctx = self.context;
+        diagnostic.print("LFM2_PRIVATE_TARGET_GPU call={d} rows={d} segments={d} recorded={} unrecorded_head_last={} tiled={} head_rows={d} captured={} phase=serving mode={s} invalid=false spans={d} command_gpu_ms={d:.6} counter_gpu_ms={d:.6} cpu_delta_ns={d} gpu_delta_ticks={d} ns_per_tick={d:.9} class_units=spans:gpu_ms{s}\n", .{ self.call, ctx.rows, ctx.segments, ctx.recorded, ctx.unrecorded_head_last, ctx.tiled, ctx.head_rows, ctx.captured, @tagName(self.recorder.capability().mode()), spans.len, command_seconds * 1e3, total * 1e3, calibration.after.cpu - calibration.before.cpu, calibration.after.gpu - calibration.before.gpu, (try calibration.secondsPerTick()) * 1e9, buffer[0..used] });
+        self.active = false;
+    }
+
+    pub fn deinit(self: *Probe) void {
+        self.recorder.deinit() catch unreachable;
+    }
+};

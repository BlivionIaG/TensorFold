+    tokens: [max_depth]u32,
+    token_count: usize,
+    suffix: [8]u32,
+    suffix_count: usize,
+    last_match: ?i64,
+    last_end: ?usize,
+    trusted: bool,
+    recalled: bool,
+    reserved: bool,

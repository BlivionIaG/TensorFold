--- /dev/null
+++ b/zig/src/core/lanes/dspark_probe_private.zig
@@ -0,0 +1,435 @@
+//! Private diagnostic only: no production policy, allocation, synchronization or arithmetic changes.
+const std = @import("std");
+extern "c" fn mach_absolute_time() u64;
+const Timebase = extern struct { numer: u32, denom: u32 };
+extern "c" fn mach_timebase_info(info: *Timebase) c_int;
+extern "c" fn write(fd: c_int, bytes: [*]const u8, len: usize) isize;
+
+/// One bounded write: server logging must not splice its fields into a diagnostic record.
+pub fn print(comptime fmt: []const u8, args: anytype) void {
+    var buffer: [4096]u8 = undefined;
+    buffer[0] = '\n';
+    const text = std.fmt.bufPrint(buffer[1..], fmt, args) catch unreachable;
+    const bytes = buffer[0 .. text.len + 1];
+    const sent = write(2, bytes.ptr, bytes.len);
+    std.debug.assert(sent >= 0 and @as(usize, @intCast(sent)) == bytes.len);
+}
+
+
+pub const Kind = enum { step, plan, allocation, reservation, copy, draw, hold_quote, context_quote };
+const names = [_][]const u8{ "step", "plan", "allocation", "reservation", "copy", "draw", "hold_quote", "context_quote" };
+var calls: [names.len]u64 = @splat(0);
+var ticks: [names.len]u64 = @splat(0);
+const Target = struct { calls: u64 = 0, rows: u64 = 0, captured: u64 = 0, encode_ticks: u64 = 0, gpu_ms: f64 = 0, timed_gpu_calls: u64 = 0, rows_by_count: [33]u64 = @splat(0) };
+var targets: [2]Target = .{ .{}, .{} };
+const RowTarget = struct { calls: u64 = 0, captured: u64 = 0, encode_ticks: u64 = 0, gpu_ms: f64 = 0, timed_gpu_calls: u64 = 0 };
+var row_targets: [2][33]RowTarget = .{ @splat(.{}), @splat(.{}) };
+var snapshot_count: u64 = 0;
+
+// The target-class probe uses this to exclude native startup calibration.
+pub var engine_initialized: bool = false;
+var copy_trace_enabled = false;
+
+pub fn reset() void {
+    engine_initialized = true;
+    const copy_flag = std.c.getenv("LFM2_PRIVATE_COPY_TRACE");
+    copy_trace_enabled = if (copy_flag) |value| value[0] == '1' else false;
+    resetCopies();
+    calls = @splat(0);
+    ticks = @splat(0);
+    targets = .{ .{}, .{} };
+    row_targets = .{ @splat(.{}), @splat(.{}) };
+    snapshot_count = 0;
+}
+
+pub fn now() u64 {
+    return mach_absolute_time();
+}
+
+pub fn span(kind: Kind, start: u64) void {
+    const i = @intFromEnum(kind);
+    calls[i] += 1;
+    ticks[i] += now() - start;
+}
+
+pub fn count(kind: Kind) void {
+    calls[@intFromEnum(kind)] += 1;
+}
+
+pub fn target(encode_ticks: u64, seconds: f64, captured: bool, record: bool, rows: usize) void {
+    const value = &targets[@intFromBool(record)];
+    value.calls += 1;
+    value.rows += rows;
+    value.rows_by_count[@min(rows, 32)] += 1;
+    value.captured += @intFromBool(captured);
+    value.encode_ticks += encode_ticks;
+    const shaped = if (rows <= 32) &row_targets[@intFromBool(record)][rows] else null;
+    if (shaped) |v| {
+        v.calls += 1;
+        v.captured += @intFromBool(captured);
+        v.encode_ticks += encode_ticks;
+    }
+    if (seconds > 0 and std.math.isFinite(seconds)) {
+        value.gpu_ms += seconds * 1000;
+        value.timed_gpu_calls += 1;
+        if (shaped) |v| {
+            v.gpu_ms += seconds * 1000;
+            v.timed_gpu_calls += 1;
+        }
+    }
+}
+
+pub fn snapshot() void {
+    snapshot_count += 1;
+    print("DSPARK_PRIVATE_SNAPSHOT index={d}\n", .{snapshot_count});
+    report();
+}
+
+pub fn report() void {
+    reportCopies();
+    var base: Timebase = .{ .numer = 0, .denom = 0 };
+    if (mach_timebase_info(&base) != 0 or base.denom == 0) return;
+    const to_ms = @as(f64, @floatFromInt(base.numer)) / @as(f64, @floatFromInt(base.denom)) / 1e6;
+    for (names, calls, ticks, 0..) |name, n, taken, i| {
+        if (i >= @intFromEnum(Kind.hold_quote)) {
+            print("DSPARK_PRIVATE_COUNTER kind={s} calls={d}\n", .{ name, n });
+        } else {
+            print("DSPARK_PRIVATE_COUNTER kind={s} calls={d} wall_ms={d:.6}\n", .{ name, n, @as(f64, @floatFromInt(taken)) * to_ms });
+        }
+    }
+    for (targets, [_][]const u8{ "prefill", "decode" }, 0..) |value, phase, index| {
+        print("DSPARK_PRIVATE_TARGET phase={s} calls={d} rows={d} captured_calls={d} encode_cpu_ms={d:.6} gpu_ms={d:.6} timed_gpu_calls={d}\n", .{ phase, value.calls, value.rows, value.captured, @as(f64, @floatFromInt(value.encode_ticks)) * to_ms, value.gpu_ms, value.timed_gpu_calls });
+        var shaped_calls: u64 = 0;
+        for (row_targets[index], 0..) |shape, rows| {
+            if (shape.calls == 0) continue;
+            shaped_calls += shape.calls;
+            print("DSPARK_PRIVATE_TARGET_SHAPE phase={s} rows={d} calls={d} captured_calls={d} encode_cpu_ms={d:.6} gpu_ms={d:.6} timed_gpu_calls={d}\n", .{ phase, rows, shape.calls, shape.captured, @as(f64, @floatFromInt(shape.encode_ticks)) * to_ms, shape.gpu_ms, shape.timed_gpu_calls });
+        }
+        print("DSPARK_PRIVATE_TARGET_SHAPE_LIMIT phase={s} calls_above32={d}\n", .{ phase, value.calls - shaped_calls });
+        print("DSPARK_PRIVATE_ROW_COUNTS phase={s} bins={any}\n", .{ phase, value.rows_by_count });
+    }
+}
+
+// Private, single engine-thread buffers. No allocator, formatting, I/O, clock read,
+// GPU work or synchronization is added by these recorders. All output is at idle.
+// Overflow is explicit; null prices remain null, never an invented zero price.
+const max_plans = 8192;
+const max_rounds = 4096;
+const max_requests = 256;
+const max_depth = 32;
+const max_width = 64;
+const Request = struct {
+    ptr: usize,
+    id_hash: u64,
+    id: [96]u8,
+    id_len: usize,
+    prompt_hash: u64,

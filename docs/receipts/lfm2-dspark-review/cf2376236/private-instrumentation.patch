diff --git a/zig/src/core/lanes/dspark_probe_private.zig b/zig/src/core/lanes/dspark_probe_private.zig
new file mode 100644
index 000000000..c88933464
--- /dev/null
+++ b/zig/src/core/lanes/dspark_probe_private.zig
@@ -0,0 +1,60 @@
+//! Private diagnostic only: no production policy, allocation, synchronization or arithmetic changes.
+const std = @import("std");
+extern "c" fn mach_absolute_time() u64;
+const Timebase = extern struct { numer: u32, denom: u32 };
+extern "c" fn mach_timebase_info(info: *Timebase) c_int;
+
+pub const Kind = enum { step, plan, allocation, reservation, copy, draw, hold_quote, context_quote };
+const names = [_][]const u8{ "step", "plan", "allocation", "reservation", "copy", "draw", "hold_quote", "context_quote" };
+var calls: [names.len]u64 = @splat(0);
+var ticks: [names.len]u64 = @splat(0);
+const Target = struct { calls: u64 = 0, rows: u64 = 0, captured: u64 = 0, encode_ticks: u64 = 0, gpu_ms: f64 = 0, timed_gpu_calls: u64 = 0 };
+var targets: [2]Target = .{ .{}, .{} };
+
+pub fn reset() void {
+    calls = @splat(0);
+    ticks = @splat(0);
+    targets = .{ .{}, .{} };
+}
+
+pub fn now() u64 {
+    return mach_absolute_time();
+}
+
+pub fn span(kind: Kind, start: u64) void {
+    const i = @intFromEnum(kind);
+    calls[i] += 1;
+    ticks[i] += now() - start;
+}
+
+pub fn count(kind: Kind) void {
+    calls[@intFromEnum(kind)] += 1;
+}
+
+pub fn target(encode_ticks: u64, seconds: f64, captured: bool, record: bool, rows: usize) void {
+    const value = &targets[@intFromBool(record)];
+    value.calls += 1;
+    value.rows += rows;
+    value.captured += @intFromBool(captured);
+    value.encode_ticks += encode_ticks;
+    if (seconds > 0 and std.math.isFinite(seconds)) {
+        value.gpu_ms += seconds * 1000;
+        value.timed_gpu_calls += 1;
+    }
+}
+
+pub fn report() void {
+    var base: Timebase = .{ .numer = 0, .denom = 0 };
+    if (mach_timebase_info(&base) != 0 or base.denom == 0) return;
+    const to_ms = @as(f64, @floatFromInt(base.numer)) / @as(f64, @floatFromInt(base.denom)) / 1e6;
+    for (names, calls, ticks, 0..) |name, n, taken, i| {
+        if (i >= @intFromEnum(Kind.hold_quote)) {
+            std.debug.print("DSPARK_PRIVATE_COUNTER kind={s} calls={d}\n", .{ name, n });
+        } else {
+            std.debug.print("DSPARK_PRIVATE_COUNTER kind={s} calls={d} wall_ms={d:.6}\n", .{ name, n, @as(f64, @floatFromInt(taken)) * to_ms });
+        }
+    }
+    for (targets, [_][]const u8{ "prefill", "decode" }) |value, phase| {
+        std.debug.print("DSPARK_PRIVATE_TARGET phase={s} calls={d} rows={d} captured_calls={d} encode_cpu_ms={d:.6} gpu_ms={d:.6} timed_gpu_calls={d}\n", .{ phase, value.calls, value.rows, value.captured, @as(f64, @floatFromInt(value.encode_ticks)) * to_ms, value.gpu_ms, value.timed_gpu_calls });
+    }
+}

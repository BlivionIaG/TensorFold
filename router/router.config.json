{
  "listen": {
    "host": "127.0.0.1",
    "port": 8000
  },
  "public_model": "DeepSeek-V4.1-Flash",
  "accept_any_model": true,
  "class_suffixes": {
    ":interactive": "interactive",
    ":background": "background",
    ":batch": "background",
    "-background": "background"
  },
  "class_header": "X-Request-Class",
  "session_header": "X-Session-Id",
  "route_header": "X-Route-To",
  "explain_header": "X-Router-Explain",
  "expected_output_header": "X-Expected-Output-Tokens",
  "slo_ttft_header": "X-SLO-TTFT",
  "default_class": "interactive",
  "client_api_key_file": null,
  "max_body_mb": 64,
  "time_scale": 1.0,
  "log": {
    "explain": false,
    "explain_file": null,
    "access": true,
    "ring": 200
  },
  "mode": {
    "dry_run": false,
    "shadow": null
  },
  "policy": {
    "mode": "cost",
    "w_int": 1.0,
    "primary_bias_s": 0.3,
    "primary_bias_frac": 0.15,
    "estimate_ctx_margin": 0.05,
    "classes": {
      "interactive": {
        "slo": true,
        "w_int": null,
        "prefer_role": null,
        "secondary_bonus_s": 0.0,
        "secondary_max_backlog_s": null
      },
      "background": {
        "slo": false,
        "w_int": 2.0,
        "prefer_role": "secondary",
        "secondary_bonus_s": 20.0,
        "secondary_max_backlog_s": 240.0
      }
    },
    "slo_penalty": 3.0,
    "interf_overlap": true,
    "slo": {
      "ttft_base_s": 1.5,
      "ttft_per_ktok_s": 0.55,
      "itl_s": 0.1
    },
    "reject_ttft_s": null
  },
  "tokens": {
    "mode": "auto",
    "chars_per_token": 3.5,
    "msg_overhead_tokens": 4,
    "base_overhead_tokens": 2,
    "calibration_alpha": 0.1,
    "exact_margin": 0.12,
    "exact_timeout_s": 1.5,
    "exact_cache": 512,
    "default_output_tokens": 300,
    "output_warmup": true,
    "output_alpha": 0.1,
    "ctx_output_cap": 4096
  },
  "affinity": {
    "enabled": true,
    "ttl_s": 21600.0,
    "max_entries": 200000,
    "stride_chars": 4096,
    "linear_until_chars": 65536,
    "growth": 1.125,
    "min_prefix_tokens": 256,
    "record_reply": false
  },
  "health": {
    "interval_s": 5.0,
    "timeout_s": 2.0,
    "load_poll_s": 2.0,
    "load_timeout_s": 1.5,
    "external_load": true
  },
  "breaker": {
    "failure_threshold": 3,
    "cooldown_s": 10.0,
    "max_cooldown_s": 120.0,
    "half_open_max": 1
  },
  "failover": {
    "max_attempts": 2,
    "connect_timeout_s": 3.0,
    "first_byte_timeout_s": 30.0,
    "first_byte_per_ptok_s": 2.0,
    "idle_timeout_s": 120.0,
    "retry_statuses": [
      429,
      502,
      503,
      504
    ]
  },
  "calibration": {
    "enabled": true,
    "alpha": 0.2,
    "min_scale": 0.4,
    "max_scale": 3.0,
    "min_rows": 256,
    "min_tokens": 16
  },
  "pd": {
    "enabled": false,
    "prefill_backend": "S",
    "decode_backend": "M",
    "mm_never": true,
    "export_factor": 1.05,
    "handoff": {
      "link_extra_s": 0.15,
      "link_gbit": 29.0,
      "kv_bytes_per_token": 3700,
      "landing_base_s": 0.04,
      "landing_per_token_s": 1.1e-05,
      "tail_s": 0.045
    },
    "min_rows": 4096,
    "max_export_tokens": 262144,
    "mu": 1.0,
    "greedy_only_decode": true,
    "s_only_fields": [
      "response_format",
      "guided_json",
      "guided_regex",
      "guided_grammar",
      "logprobs",
      "top_logprobs",
      "prompt_logprobs"
    ],
    "exact_header": "X-Exactness",
    "fallback": {
      "failures": 3,
      "cooldown_s": 60.0
    }
  },
  "admission": {
    "enabled": true,
    "max_wait_s": 120.0,
    "poll_s": 0.25,

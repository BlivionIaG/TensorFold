+/// The persistent stream tile's grid (tiles/stream.hpp stream_persistent): row blocks on y, items on z, and on x blocks that take the `tiles` column tiles in
+/// turn: the compute units' worth in all (`cus` 0 where unknown: a block a tile).
+pub fn persistent(tiles: c_uint, ny: c_uint, items: c_int, cus: c_int) hl.Dim3 {
+    const resident: c_uint = if (cus > 0) @max(1, @as(c_uint, @intCast(cus)) / ny) else tiles;
+    return .{ .x = @min(tiles, resident), .y = ny, .z = @intCast(items) };
+}

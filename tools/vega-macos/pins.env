# Toolchain pins for building the HIP kernels for gfx900 on macOS arm64 (docs/recipes/vega-macos.md).
# TheRock nightly wheel index: HIP headers + ROCm device libraries (ocml/ockl/oclc bitcode). AMD's clang inside the wheel is Linux x86_64 and is NOT used.
ROCM_INDEX=https://rocm.nightlies.amd.com/whl-multi-arch/
ROCM_VERSION=10.1.0a20260822
ROCM_HIP_VERSION=7.16.26332
ROCM_WHEEL=rocm_sdk_core-10.1.0a20260822-py3-none-linux_x86_64.whl
ROCM_WHEEL_SIZE=416591253
ROCM_WHEEL_SHA256=cf376d3465cffd0c755a1e1ec08324c519eaf3d79c56778ffede1f6a7a2a5729
# Homebrew LLVM (clang + lld + llvm-objdump); the wheel's own clang is 23, so is brew's `llvm` / `lld`.
LLVM_PREFIX=/opt/homebrew/opt/llvm
LLD_PREFIX=/opt/homebrew/opt/lld
LLVM_VERSION=23.1.3
